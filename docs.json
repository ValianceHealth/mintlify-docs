{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Valiance Health",
  "description": "Public product documentation and help center for Healthproximate by Valiance Health.",
  "colors": {
    "primary": "#14143C",
    "light": "#54A2FF",
    "dark": "#155DFC"
  },
  "fonts": {
    "family": "Geist"
  },
  "background": {
    "color": {
      "light": "#FCFCFF",
      "dark": "#0A0A0A"
    }
  },
  "logo": {
    "light": "/logo/valiance-health-primary-full-color.png",
    "dark": "/logo/valiance-health-primary-white.png"
  },
  "favicon": "/favicon.svg",
  "thumbnails": {
    "appearance": "dark",
    "background": "/images/og-background.png",
    "fonts": {
      "family": "Geist"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.valiancehealth.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Getting Started",
            "pages": [
              "getting-started/index",
              "getting-started/onboarding-checklist",
              "getting-started/first-steps"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "workflows/entity-resolver",
              "workflows/dashboard",
              "workflows/analytics",
              "workflows/predictions",
              "workflows/simulation"
            ]
          },
          {
            "group": "AI",
            "pages": [
              "ai/workspaces"
            ]
          },
          {
            "group": "API",
            "pages": [
              "api/overview"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "faq",
              "support"
            ]
          },
          {
            "group": "Release Notes",
            "pages": [
              "release-notes/index"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api/introduction",
              "api/authentication",
              "api/errors-and-limits",
              "api/redaction-receipts"
            ]
          },
          {
            "group": "Gateway",
            "openapi": "api/openapi-commercial.yaml",
            "pages": [
              "api/models",
              "api/tool-calling",
              "POST /api/v1/llm/chat/completions",
              "POST /api/v1/redact/"
            ]
          },
          {
            "group": "DRG",
            "openapi": "api/openapi-commercial.yaml",
            "pages": [
              "POST /api/v1/drg/classify/",
              "POST /api/v1/drg/agent/",
              "POST /api/v1/drg/batch/",
              "GET /api/v1/drg/batch/{job_id}/",
              "POST /api/v1/fhir/drg/$classify"
            ]
          },
          {
            "group": "Vocabulary",
            "openapi": "api/openapi-commercial.yaml",
            "pages": [
              "POST /api/v1/search/",
              "GET /api/v1/search/domains/",
              "GET /api/v1/search/vocabularies/"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:admin@valiancehealth.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Request Access",
      "href": "mailto:admin@valiancehealth.ai"
    }
  },
  "footer": {
    "socials": {
      "website": "https://valiancehealth.com"
    },
    "links": [
      {
        "header": "Company",
        "items": [
          {
            "label": "Security",
            "href": "https://valiancehealth.com/security"
          },
          {
            "label": "Privacy Policy",
            "href": "https://valiancehealth.com/privacy-policy"
          },
          {
            "label": "Terms of Service",
            "href": "https://valiancehealth.com/terms-of-service"
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  }
}
